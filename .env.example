PROJECT_NAME=CLEARWAY
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=["https://your-frontend.onrender.com"]
ALLOW_ALL_ORIGINS=false
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
# Groq 실패(레이트리밋 등) 시 자동 폴백 — https://cloud.cerebras.ai 무료 키
CEREBRAS_API_KEY=your-cerebras-api-key
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=your-email@naver.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-email@naver.com

# 운항 현황(FlightStatus) 실시간 데이터 — https://rapidapi.com/aedbx-aedbx/api/aerodatabox 에서 무료 키 발급
AERODATABOX_API_KEY=your-rapidapi-key
